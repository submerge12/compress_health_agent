{
  "name": "compass-health-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tools/context": {
      "types": "./dist/tools/context.d.ts",
      "import": "./dist/tools/context.js"
    },
    "./tools/handlers": {
      "types": "./dist/tools/handlers.d.ts",
      "import": "./dist/tools/handlers.js"
    },
    "./engine/types": {
      "types": "./dist/engine/types.d.ts",
      "import": "./dist/engine/types.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev:repl": "tsx src/dev-repl.ts",
    "start": "tsx src/index.ts",
    "serve:display": "tsx src/server/serve.ts",
    "mcp:stdio": "tsx src/mcp/stdio.ts",
    "codex:verify-binding": "tsx src/mcp/verify-codex-binding.ts",
    "projection:worker": "tsx src/domain/projection-worker-main.ts",
    "smoke:exports": "pnpm build && node tests/smoke/resolve-package-exports.mjs",
    "test": "vitest run",
    "test:mcp:conformance": "tsx tests/mcp/run-official-conformance.ts",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/run-seed.ts",
    "db:embed-catalog": "tsx src/db/embed-catalog.ts",
    "db:embed-memories": "tsx src/db/embed-memories.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "user:bootstrap": "tsx src/db/bootstrap-user.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/conformance": "0.2.0-alpha.11",
    "@modelcontextprotocol/node": "^2.0.0",
    "@types/node": "^22.19.21",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
